# Copy to .env and fill in your own values. Never commit .env.

# Snowflake connection (required)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=DRIVE_HEALTH
SNOWFLAKE_SCHEMA=BRONZE

# Explanation model. Any OpenAI-compatible chat endpoint works.
# Local example: LLM_MODEL=gemma4:e4b  LLM_BASE_URL=http://localhost:11434/v1  LLM_REASONING_EFFORT=none
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_BASE_URL=
# Optional: Ollama needs no key; leave blank unless your endpoint requires one.
LLM_API_KEY=
# Optional: "none" for thinking models such as gemma4 so the answer fits in max_tokens.
LLM_REASONING_EFFORT=

# Local embedding model (optional; these are the defaults)
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_MODEL_REVISION=
